@model MyStore.Models.User
@{
    ViewBag.Title = "Xoá tài khoản Admin";
}

<div class="form-title">Xoá tài khoản Admin</div>
<div class="form-box">
    <h4>Bạn có chắc chắn muốn xoá tài khoản <strong>@Model.Username</strong>?</h4>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" onclick="return confirmDelete('Xoá tài khoản này?')">Xoá</button>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    }
</div>
