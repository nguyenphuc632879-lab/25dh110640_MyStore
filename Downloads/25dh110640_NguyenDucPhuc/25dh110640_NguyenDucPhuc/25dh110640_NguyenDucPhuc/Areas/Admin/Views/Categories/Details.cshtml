@model MyStore.Models.Category
@{
    ViewBag.Title = "Chi tiết danh mục";
}

<div class="form-title">Chi tiết danh mục</div>
<div class="form-box">
    <dl class="dl-horizontal">
        <dt>Mã danh mục</dt>
        <dd>@Html.DisplayFor(model => model.CategoryID)</dd>

        <dt>Tên danh mục</dt>
        <dd>@Html.DisplayFor(model => model.CategoryName)</dd>

        <dt>Số sản phẩm</dt>
        <dd>@(Model.Products != null ? Model.Products.Count : 0)</dd>
    </dl>

    @Html.ActionLink("Sửa", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</div>
