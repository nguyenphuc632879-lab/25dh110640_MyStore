@model MyStore.Models.ViewModel.HomeProductVM
@{
    Layout = null;
}
<div class="product-grid">
    @foreach (var item in Model.NewProducts)
    {
        <div class="product-card">
            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.png")" alt="@item.ProductName" class="img-responsive center-block" />
                <div class="product-name">@item.ProductName</div>
            </a>
            <div class="text-muted" style="font-size:12px;">
                @(item.Category != null ? item.Category.CategoryName : "")
            </div>
            <div class="product-price">@String.Format("{0:#,##0}", item.ProductPrice) đ</div>
            <div style="margin-top:8px;">
                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@item.ProductID" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn-buy"><i class="fa fa-cart-plus"></i> Thêm vào giỏ</button>
                }
            </div>
        </div>
    }
</div>

<div class="pagination-container">
    @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", "Home", new { page = page, searchTerm = Model.SearchTerm }),
        PagedListRenderOptions.ClassicPlusFirstAndLast)
</div>
