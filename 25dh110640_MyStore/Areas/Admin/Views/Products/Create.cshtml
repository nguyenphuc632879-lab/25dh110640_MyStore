@* BE#3: Thêm mới sản phẩm (có upload ảnh) *@
@model MyStore.Models.Product
@{
    ViewBag.Title = "Thêm mới sản phẩm";
}

<div class="form-title">Thêm mới sản phẩm</div>
<div class="form-box">
    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.Partial("PVCreateEditProduct", Model)

        <button type="submit" class="btn btn-danger">Lưu</button>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    }
</div>
