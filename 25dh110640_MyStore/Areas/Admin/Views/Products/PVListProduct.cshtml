@* BE#4: Partial View hiển thị kết quả tìm kiếm + phân trang *@
@model MyStore.Models.ViewModel.ProductSearchVM
@{
    Layout = null;
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width:60px;">Mã</th>
            <th style="width:80px;">Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th style="width:120px;">Giá</th>
            <th style="width:200px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>
                    <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.png")" style="width:50px;height:50px;object-fit:contain;" />
                </td>
                <td>@item.ProductName</td>
                <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                <td>@String.Format("{0:#,##0}", item.ProductPrice) đ</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Xoá", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">Không tìm thấy sản phẩm nào.</div>
}

<div class="pagination-container">
    @Html.PagedListPager(Model.Products, page => Url.Action("Index", "Products", new
    {
        page = page,
        SearchTerm = Model.SearchTerm,
        MinPrice = Model.MinPrice,
        MaxPrice = Model.MaxPrice,
        SortOrder = Model.SortOrder
    }), PagedListRenderOptions.ClassicPlusFirstAndLast)
</div>
