@model _25dh110640_MyStore.Models.Product

<dl class="dl-horizontal">
    <dt>Hình ảnh</dt>
    <dd>
        <img src="@Url.Content(string.IsNullOrEmpty(Model.ProductImage) ? "~/Content/images/default.png" : Model.ProductImage)" style="height:150px;max-width:150px;" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default.png")';" />
    </dd>

    <dt>Tên sản phẩm</dt>
    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

    <dt>Mô tả</dt>
    <dd>@Html.DisplayFor(model => model.ProductDecription)</dd>

    <dt>Đơn giá</dt>
    <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

    <dt>Danh mục</dt>
    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
</dl>
