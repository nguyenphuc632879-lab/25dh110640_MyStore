@model _25dh110640_MyStore.Models.User

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THÔNG TIN CHI TIẾT TÀI KHOẢN</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên tài khoản</dt>
        <dd>@Html.DisplayFor(model => model.Username)</dd>

        <dt>Mật khẩu</dt>
        <dd>@Html.DisplayFor(model => model.Password)</dd>

        <dt>Vai trò</dt>
        <dd>@Html.DisplayFor(model => model.UserRole)</dd>
    </dl>

    <p>
        @Html.ActionLink("Sửa", "Edit", new { id = Model.Username }, new { @class = "btn btn-primary btn-sm" }) |
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
    </p>
</div>
