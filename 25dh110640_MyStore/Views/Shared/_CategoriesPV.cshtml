@* Partial View: Menu danh mục sản phẩm trên Header (BE#6 - CategoryMenu) *@
@model IEnumerable<MyStore.Models.Category>
@{
    Layout = null;
}
<ul class="nav navbar-nav category-menu">
    <li class="dropdown">
        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button">
            <i class="fa fa-list"></i> Danh mục <span class="caret"></span>
        </a>
        <ul class="dropdown-menu">
            <li>@Html.ActionLink("Tất cả sản phẩm", "ProductList", "Home", new { id = (int?)null }, null)</li>
            <li role="separator" class="divider"></li>
            @foreach (var item in Model)
            {
                <li>
                    @Html.ActionLink(item.CategoryName, "ProductList", "Home", new { id = item.CategoryID }, null)
                </li>
            }
        </ul>
    </li>
</ul>
