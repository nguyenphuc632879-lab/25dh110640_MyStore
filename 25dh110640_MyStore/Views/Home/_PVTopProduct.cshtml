@* Partial View: Top sản phẩm bán chạy cùng danh mục *@
@model MyStore.Models.ViewModel.ProductDetailVM
@{
    Layout = null;
}
<div class="related-box top-deals">
    <div class="row">
        @foreach (var item in Model.TopProducts)
        {
            <div class="col-md-4 col-sm-6">
                <div class="product-card">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.png")" alt="@item.ProductName" class="img-responsive center-block" />
                        <div class="product-name">@item.ProductName</div>
                        <div class="product-price">@String.Format("{0:#,##0}", item.ProductPrice) đ</div>
                    </a>
                    @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@item.ProductID" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn-buy"><i class="fa fa-cart-plus"></i> Thêm vào giỏ</button>
                    }
                </div>
            </div>
        }
    </div>
    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetail", "Home",
            new { id = Model.product.ProductID, quantity = Model.quantity, page = page }),
            PagedListRenderOptions.ClassicPlusFirstAndLast)
    </div>
</div>
