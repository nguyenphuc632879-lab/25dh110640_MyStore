@* Partial View: Sản phẩm nổi bật (top 10 bán chạy nhất) *@
@model MyStore.Models.ViewModel.HomeProductVM
@{
    Layout = null;
}
<div class="featured-slider">
    <button type="button" class="slider-btn slider-prev" onclick="slideProducts(this, -1)" aria-label="Trước">&lsaquo;</button>
    <div class="slider-track">
        @foreach (var item in Model.FeaturedProducts)
        {
            <div class="featured-item">
                <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                    <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default.png")" alt="@item.ProductName" class="img-responsive center-block" />
                    <div class="product-name">@item.ProductName</div>
                    <div class="product-price">@String.Format("{0:#,##0}", item.ProductPrice) đ</div>
                </a>
            </div>
        }
    </div>
    <button type="button" class="slider-btn slider-next" onclick="slideProducts(this, 1)" aria-label="Sau">&rsaquo;</button>
</div>
@if (!Model.FeaturedProducts.Any())
{
    <p class="text-muted">Không tìm thấy sản phẩm nào.</p>
}
