@* Trang Xác nhận đơn hàng (BE#7-4.2) *@
@model MyStore.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
}

<h3 class="section-title">Đặt hàng thành công!</h3>

<div class="alert alert-success">
    <i class="fa fa-check-circle"></i>
    Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là <strong>#@Model.OrderID</strong>.
</div>

<!-- ==================== THÔNG TIN ĐƠN HÀNG ==================== -->
<div class="form-title">Thông tin đơn hàng</div>
<div class="form-box">
    <dl class="dl-horizontal">
        <dt>Mã đơn hàng</dt>
        <dd>@Model.OrderID</dd>
        <dt>Ngày đặt hàng</dt>
        <dd>@String.Format("{0:dd/MM/yyyy}", Model.OrderDate)</dd>
        <dt>Tổng số tiền</dt>
        <dd>@String.Format("{0:#,##0}", Model.TotalAmount) đ</dd>
        <dt>Trạng thái thanh toán</dt>
        <dd>@Model.PaymentStatus</dd>
        <dt>Phương thức thanh toán</dt>
        <dd>@(Model.PaymentMethod ?? "—")</dd>
        <dt>Phương thức giao hàng</dt>
        <dd>@(Model.DeliveryMethod ?? "—")</dd>
        <dt>Địa chỉ giao hàng</dt>
        <dd>@Model.ShippingAddress</dd>
    </dl>
</div>

<!-- ==================== CHI TIẾT ĐƠN HÀNG ==================== -->
<div class="form-title">Chi tiết đơn hàng</div>
<div class="form-box">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th style="width:80px;">Số lượng</th>
                <th style="width:140px;">Đơn giá</th>
                <th style="width:140px;">Tổng giá</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>@(d.Product != null ? d.Product.ProductName : "#" + d.ProductID)</td>
                    <td>@d.Quantity</td>
                    <td>@String.Format("{0:#,##0}", d.UnitPrice) đ</td>
                    <td>@String.Format("{0:#,##0}", d.TotalPrice) đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Tổng cộng</th>
                <th class="text-danger">@String.Format("{0:#,##0}", Model.TotalAmount) đ</th>
            </tr>
        </tfoot>
    </table>
</div>

<p>
    @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-default" })
    @Html.ActionLink("Xem đơn hàng của tôi", "MyOrder", "Order", null, new { @class = "btn btn-danger" })
</p>
